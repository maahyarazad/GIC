{
  "compilerOptions": {
    /* ==== Core ====*/ 
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",

    /* ==== React JSX Support ==== */
    "jsx": "react-jsx",

    /* ==== Paths / Aliases ==== */
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"]
    },

    /* ==== Type Checking ==== */
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* ==== Output ==== */
    "noEmit": true,

    /* ==== Other Useful Flags ==== */
    "forceConsistentCasingInFileNames": true
  },

  /* Include JSX + TSX + all source files */
  "include": ["src"],

  /* Exclude build output */
  "exclude": ["node_modules", "dist"]
}
