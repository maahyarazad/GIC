{
  "compilerOptions": {
    "target": "ES6",
    "module": "CommonJS",
    "moduleResolution": "Node",
 "experimentalDecorators": true,
    "emitDecoratorMetadata": true,  // often needed for tsoa / routing-controllers etc
    "outDir": "dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "strict": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
