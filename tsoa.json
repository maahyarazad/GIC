{
  "entryFile": "src/server.ts",
  "controllerPathGlobs": [
    "src/controllers/*.ts"
  ],
  "noImplicitAdditionalProperties": "throw",
  "spec": {
    "outputDirectory": "src/swagger",
    "specVersion": 3
  },
  "routes": {
    "routesDir": "src/routes"
  },
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types", "./src/@types"]
  }
}
